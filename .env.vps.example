# Rotom Table private VPS environment example.
# Copy these values into your process manager environment or a real untracked
# .env file on the host. Keep real .env files, hostnames, credentials,
# and private campaign data out of Git.

NODE_ENV=production

# Bind Nitro to loopback when a same-host reverse proxy or access gate fronts the app.
# Change this only for a private network design you control.
NITRO_HOST=127.0.0.1
NITRO_PORT=3000

# Store campaign-owned JSON outside the application checkout on the VPS.
ROTOM_CAMPAIGN_ROOT=/srv/rotom-table/campaign
