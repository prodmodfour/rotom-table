# Example systemd unit for private trusted-table Rotom Table VPS hosting.
# Install as /etc/systemd/system/rotom-table.service after reviewing paths,
# creating the service user, and building the app in WorkingDirectory.
# Keep real environment files, campaign data, SQLite databases/WAL sidecars,
# and backup archives outside Git. The EnvironmentFile should set
# ROTOM_CAMPAIGN_ROOT, any ROTOM_DB_PATH override, and the exact
# ROTOM_ENABLE_HOSTED_WRITES=1 opt-in only when the private host is ready.
# The standard campaign root below is the unit's only writable host path;
# review ReadWritePaths if either configured storage path is changed.

[Unit]
Description=Rotom Table private table server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rotom-table
Group=rotom-table
WorkingDirectory=/srv/rotom-table/app
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/rotom-table/rotom-table.env
ExecStart=/usr/bin/env npm run start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/srv/rotom-table/campaign
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
