{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotom-table.local/schemas/tabletop-map-v2.schema.json",
  "title": "Rotom Table TabletopMap v2",
  "type": "object",
  "required": ["schemaVersion", "slug", "name", "dimensions", "voxels", "placements"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "folder": { "type": "string" },
    "dimensions": { "$ref": "#/$defs/dimensions" },
    "groundLevelY": { "type": "integer", "minimum": 0 },
    "playerVisible": { "type": "boolean" },
    "voxels": { "type": "array", "items": { "$ref": "#/$defs/voxel" } },
    "hazards": { "type": "array", "items": { "$ref": "#/$defs/hazard" } },
    "fieldEffects": { "$ref": "#/$defs/fieldEffects" },
    "placements": { "type": "array", "items": { "$ref": "#/$defs/placement" } },
    "lights": { "type": "array", "items": { "$ref": "#/$defs/light" } },
    "initiative": { "$ref": "#/$defs/initiative" },
    "activeScene": { "anyOf": [{ "$ref": "#/$defs/activeScene" }, { "type": "null" }] },
    "encounterState": { "$ref": "#/$defs/encounterState" },
    "metadata": { "type": "object", "additionalProperties": true },
    "createdAt": { "type": "number" },
    "updatedAt": { "type": "number" }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 1, "maximum": 200 },
        "y": { "type": "integer", "minimum": 1, "maximum": 200 },
        "z": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "anchor": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "voxel": {
      "type": "object",
      "required": ["x", "y", "z", "materialId"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" },
        "materialId": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#?[0-9a-fA-F]{6}$" },
        "blocksMovement": { "type": "boolean" },
        "blocksSight": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "hazard": {
      "type": "object",
      "required": ["kind", "x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["spikes", "toxic-spikes", "sticky-web", "stealth-rock", "fire"] },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" },
        "layer": { "type": "integer", "minimum": 1, "maximum": 2 },
        "owner": { "type": "string" }
      }
    },
    "fieldEffects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weather": { "type": "array", "items": { "$ref": "#/$defs/weatherEffect" } },
        "terrains": { "type": "array", "items": { "$ref": "#/$defs/terrainEffect" } },
        "rooms": { "type": "array", "items": { "$ref": "#/$defs/roomEffect" } }
      }
    },
    "weatherEffect": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["sunny", "rainy", "hail", "sandstorm"] },
        "rounds": { "type": ["integer", "null"], "minimum": 0 },
        "source": { "type": "string" }
      }
    },
    "terrainEffect": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["electric", "grassy", "misty", "psychic"] },
        "scope": { "enum": ["field", "area"] },
        "rounds": { "type": ["integer", "null"], "minimum": 0 },
        "source": { "type": "string" }
      }
    },
    "roomEffect": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["magic", "trick", "wonder"] },
        "rounds": { "type": ["integer", "null"], "minimum": 0 },
        "startsNextRound": { "type": "boolean" },
        "source": { "type": "string" }
      }
    },
    "placement": {
      "type": "object",
      "required": ["id", "sheetKind", "sheetSlug", "position"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "sheetKind": { "enum": ["pokemon", "trainer"] },
        "sheetSlug": { "type": "string" },
        "position": { "$ref": "#/$defs/anchor" },
        "sideId": { "$ref": "#/$defs/encounterSideId" },
        "initiative": { "type": ["integer", "null"] },
        "turned": { "type": "boolean" }
      }
    },
    "light": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["ambient", "point", "emissive", "zone"] },
        "position": { "$ref": "#/$defs/anchor" },
        "color": { "type": "string", "pattern": "^#?[0-9a-fA-F]{6}$" },
        "intensity": { "type": "number" },
        "radius": { "type": "number" },
        "zoneId": { "type": "string" }
      }
    },
    "initiative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activeId": { "type": ["string", "null"] },
        "round": { "type": "integer", "minimum": 1 }
      }
    },
    "activeScene": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "startedAt": { "type": "number", "minimum": 0 }
      }
    },
    "encounterState": {
      "type": "object",
      "required": [
        "schemaVersion",
        "sides",
        "effects",
        "counters",
        "history",
        "turnResources",
        "zones",
        "pendingResolutionSummaries"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "sides": { "$ref": "#/$defs/encounterSideDirectory" },
        "effects": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/encounterEffect" }
        },
        "counters": { "$ref": "#/$defs/emptyEncounterDirectory" },
        "history": { "$ref": "#/$defs/emptyEncounterDirectory" },
        "turnResources": { "$ref": "#/$defs/emptyEncounterDirectory" },
        "zones": { "$ref": "#/$defs/emptyEncounterList" },
        "pendingResolutionSummaries": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/pendingMoveResolutionPublicSummary" }
        }
      }
    },
    "encounterSideId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 64
    },
    "encounterSideDirectory": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "$ref": "#/$defs/encounterSideId" },
      "additionalProperties": { "$ref": "#/$defs/encounterSide" }
    },
    "encounterSide": {
      "type": "object",
      "required": ["id", "label", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/encounterSideId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "status": { "enum": ["active", "inactive"] }
      }
    },
    "encounterEffectStableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._:/-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "encounterEffect": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source",
        "affected",
        "createdRound",
        "createdTurn",
        "duration",
        "stacks",
        "charges",
        "tags",
        "payload",
        "dispel",
        "suppression"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/encounterEffectStableId" },
        "kind": { "enum": ["condition", "numeric-modifier", "capability"] },
        "source": { "$ref": "#/$defs/encounterEffectSource" },
        "affected": { "$ref": "#/$defs/encounterEffectAffected" },
        "createdRound": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "createdTurn": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "duration": { "$ref": "#/$defs/encounterEffectDuration" },
        "stacks": { "type": "integer", "minimum": 1, "maximum": 64 },
        "charges": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
        "stackPolicy": { "$ref": "#/$defs/encounterEffectStackPolicy" },
        "chargePolicy": { "$ref": "#/$defs/encounterEffectChargePolicy" },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/encounterEffectStableId" }
        },
        "payload": { "type": "object" },
        "dispel": { "$ref": "#/$defs/encounterEffectDispel" },
        "suppression": { "$ref": "#/$defs/encounterEffectSuppression" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "condition" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterConditionEffectPayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "numeric-modifier" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterNumericModifierEffectPayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "capability" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterCapabilityEffectPayload" } } }
        }
      ]
    },
    "encounterEffectSource": {
      "type": "object",
      "required": ["operationId", "moveId", "placementId"],
      "additionalProperties": false,
      "properties": {
        "operationId": { "$ref": "#/$defs/encounterEffectStableId" },
        "moveId": { "$ref": "#/$defs/encounterEffectStableId" },
        "placementId": { "$ref": "#/$defs/encounterEffectStableId" }
      }
    },
    "encounterEffectCell": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "y": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "z": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "encounterEffectAffected": {
      "type": "object",
      "required": ["placementIds", "sideIds", "cells"],
      "additionalProperties": false,
      "properties": {
        "placementIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/encounterEffectStableId" }
        },
        "sideIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/encounterSideId" }
        },
        "cells": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/encounterEffectCell" }
        }
      },
      "anyOf": [
        { "properties": { "placementIds": { "minItems": 1 } } },
        { "properties": { "sideIds": { "minItems": 1 } } },
        { "properties": { "cells": { "minItems": 1 } } }
      ]
    },
    "encounterEffectDuration": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "remaining"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "turns" },
            "subject": { "enum": ["source", "target"] },
            "boundary": { "enum": ["start", "end"] },
            "remaining": { "type": "integer", "minimum": 1, "maximum": 1000000 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "remaining"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "rounds" },
            "boundary": { "enum": ["start", "end"] },
            "remaining": { "type": "integer", "minimum": 1, "maximum": 1000000 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "remaining"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["scene", "until-triggered", "permanent"] },
            "remaining": { "type": "null" }
          }
        }
      ]
    },
    "encounterEffectStackPolicy": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "maxStacks"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["replace", "refresh", "independent-instance"] },
            "maxStacks": { "type": "null" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "maxStacks"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "add-stack" },
            "maxStacks": { "type": "integer", "minimum": 1, "maximum": 64 }
          }
        }
      ]
    },
    "encounterEffectChargePolicy": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "amount"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "none" },
            "amount": { "type": "null" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "amount"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "consume-on-trigger" },
            "amount": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        }
      ]
    },
    "encounterEffectDispel": {
      "oneOf": [
        {
          "type": "object",
          "required": ["policy", "tags"],
          "additionalProperties": false,
          "properties": {
            "policy": { "const": "none" },
            "tags": { "type": "array", "maxItems": 0 }
          }
        },
        {
          "type": "object",
          "required": ["policy", "tags"],
          "additionalProperties": false,
          "properties": {
            "policy": { "const": "matching-tags" },
            "tags": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/encounterEffectStableId" }
            }
          }
        }
      ]
    },
    "encounterEffectSuppressionSource": {
      "type": "object",
      "required": ["effectId", "reasonCode"],
      "additionalProperties": false,
      "properties": {
        "effectId": { "$ref": "#/$defs/encounterEffectStableId" },
        "reasonCode": { "$ref": "#/$defs/encounterEffectStableId" }
      }
    },
    "encounterEffectSuppression": {
      "type": "object",
      "required": ["sources"],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/encounterEffectSuppressionSource" }
        }
      }
    },
    "encounterConditionEffectPayload": {
      "type": "object",
      "required": ["conditionId", "action"],
      "additionalProperties": false,
      "properties": {
        "conditionId": { "$ref": "#/$defs/encounterEffectStableId" },
        "action": { "enum": ["apply", "prevent", "suppress"] },
        "saveTiming": { "enum": ["start-turn", "end-turn", null] }
      }
    },
    "encounterNumericModifierEffectPayload": {
      "type": "object",
      "required": ["attribute", "operation", "value", "rounding"],
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "enum": [
            "accuracy",
            "evasion",
            "damage-base",
            "damage",
            "damage-reduction",
            "initiative",
            "movement"
          ]
        },
        "operation": { "enum": ["add", "multiply", "set"] },
        "value": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "rounding": { "enum": ["none", "floor", "round", "ceil"] }
      }
    },
    "encounterCapabilityEffectPayload": {
      "type": "object",
      "required": ["capabilityId", "action"],
      "additionalProperties": false,
      "properties": {
        "capabilityId": { "$ref": "#/$defs/encounterEffectStableId" },
        "action": { "enum": ["grant", "suppress"] }
      }
    },
    "pendingMoveResolutionPublicSummary": {
      "type": "object",
      "required": [
        "schemaVersion",
        "resolutionId",
        "actorPlacementId",
        "canonicalMoveId",
        "phase",
        "status",
        "outstandingWindowCount",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "resolutionId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "actorPlacementId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "canonicalMoveId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "phase": {
          "enum": [
            "declare",
            "precondition",
            "pay",
            "target",
            "pre-hit",
            "accuracy",
            "hit",
            "miss",
            "damage",
            "after-damage",
            "ko",
            "movement",
            "schedule",
            "usage",
            "cleanup"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "resuming",
            "committed",
            "cancelled",
            "expired",
            "conflicted",
            "abandoned"
          ]
        },
        "outstandingWindowCount": { "type": "integer", "minimum": 0, "maximum": 64 },
        "createdAt": { "type": "integer", "minimum": 0 },
        "updatedAt": { "type": "integer", "minimum": 0 }
      }
    },
    "emptyEncounterList": {
      "type": "array",
      "maxItems": 0
    },
    "emptyEncounterDirectory": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    }
  }
}
