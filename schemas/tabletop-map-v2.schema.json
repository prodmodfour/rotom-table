{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotom-table.local/schemas/tabletop-map-v2.schema.json",
  "title": "Rotom Table TabletopMap v2",
  "type": "object",
  "required": ["schemaVersion", "slug", "name", "dimensions", "voxels", "placements"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "folder": { "type": "string" },
    "dimensions": { "$ref": "#/$defs/dimensions" },
    "groundLevelY": { "type": "integer", "minimum": 0 },
    "playerVisible": { "type": "boolean" },
    "voxels": { "type": "array", "items": { "$ref": "#/$defs/voxel" } },
    "hazards": { "type": "array", "items": { "$ref": "#/$defs/hazard" } },
    "fieldEffects": { "$ref": "#/$defs/fieldEffects" },
    "placements": { "type": "array", "items": { "$ref": "#/$defs/placement" } },
    "lights": { "type": "array", "items": { "$ref": "#/$defs/light" } },
    "initiative": { "$ref": "#/$defs/initiative" },
    "activeScene": { "anyOf": [{ "$ref": "#/$defs/activeScene" }, { "type": "null" }] },
    "encounterState": { "$ref": "#/$defs/encounterState" },
    "metadata": { "type": "object", "additionalProperties": true },
    "createdAt": { "type": "number" },
    "updatedAt": { "type": "number" }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 1, "maximum": 200 },
        "y": { "type": "integer", "minimum": 1, "maximum": 200 },
        "z": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "anchor": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "voxel": {
      "type": "object",
      "required": ["x", "y", "z", "materialId"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" },
        "materialId": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#?[0-9a-fA-F]{6}$" },
        "blocksMovement": { "type": "boolean" },
        "blocksSight": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "hazard": {
      "type": "object",
      "required": ["kind", "x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["spikes", "toxic-spikes", "sticky-web", "stealth-rock", "fire"] },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" },
        "layer": { "type": "integer", "minimum": 1, "maximum": 2 },
        "owner": { "type": "string" }
      }
    },
    "fieldEffects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weather": { "type": "array", "items": { "$ref": "#/$defs/weatherEffect" } },
        "terrains": { "type": "array", "items": { "$ref": "#/$defs/terrainEffect" } },
        "rooms": { "type": "array", "items": { "$ref": "#/$defs/roomEffect" } }
      }
    },
    "weatherEffect": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["sunny", "rainy", "hail", "sandstorm"] },
        "rounds": { "type": ["integer", "null"], "minimum": 0 },
        "source": { "type": "string" }
      }
    },
    "terrainEffect": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["electric", "grassy", "misty", "psychic"] },
        "scope": { "enum": ["field", "area"] },
        "rounds": { "type": ["integer", "null"], "minimum": 0 },
        "source": { "type": "string" }
      }
    },
    "roomEffect": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["magic", "trick", "wonder", "gravity"] },
        "rounds": { "type": ["integer", "null"], "minimum": 0 },
        "startsNextRound": { "type": "boolean" },
        "source": { "type": "string" }
      }
    },
    "placement": {
      "type": "object",
      "required": ["id", "sheetKind", "sheetSlug", "position"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "sheetKind": { "enum": ["pokemon", "trainer"] },
        "sheetSlug": { "type": "string" },
        "position": { "$ref": "#/$defs/anchor" },
        "sideId": { "$ref": "#/$defs/encounterSideId" },
        "initiative": { "type": ["integer", "null"] },
        "turned": { "type": "boolean" }
      }
    },
    "light": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["ambient", "point", "emissive", "zone"] },
        "position": { "$ref": "#/$defs/anchor" },
        "color": { "type": "string", "pattern": "^#?[0-9a-fA-F]{6}$" },
        "intensity": { "type": "number" },
        "radius": { "type": "number" },
        "zoneId": { "type": "string" }
      }
    },
    "initiative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activeId": { "type": ["string", "null"] },
        "round": { "type": "integer", "minimum": 1 }
      }
    },
    "activeScene": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "startedAt": { "type": "number", "minimum": 0 }
      }
    },
    "encounterState": {
      "type": "object",
      "required": [
        "schemaVersion",
        "sides",
        "effects",
        "counters",
        "history",
        "turnResources",
        "zones",
        "groundItems",
        "pendingResolutionSummaries"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "sides": { "$ref": "#/$defs/encounterSideDirectory" },
        "effects": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/encounterEffect" }
        },
        "counters": { "$ref": "#/$defs/emptyEncounterDirectory" },
        "history": { "$ref": "#/$defs/emptyEncounterDirectory" },
        "turnResources": { "$ref": "#/$defs/emptyEncounterDirectory" },
        "zones": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/encounterZone" }
        },
        "groundItems": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/mapGroundItem" }
        },
        "pendingResolutionSummaries": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/pendingMoveResolutionPublicSummary" }
        }
      }
    },
    "mapGroundItem": {
      "type": "object",
      "required": [
        "id",
        "canonicalItemId",
        "canonicalItemName",
        "quantity",
        "position",
        "sourceResource",
        "sourceOperationId",
        "sideId",
        "ownerPlacementId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+(?:[._:/-][A-Za-z0-9]+)*$",
          "maxLength": 200
        },
        "canonicalItemId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._:/-][a-z0-9]+)*$",
          "maxLength": 160
        },
        "canonicalItemName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "position": {
          "type": "object",
          "required": ["x", "y", "z"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "z": { "type": "integer", "minimum": 0 }
          }
        },
        "sourceResource": { "$ref": "#/$defs/mapGroundItemSourceResource" },
        "sourceOperationId": {
          "type": "string",
          "pattern": "^op_[A-Za-z0-9_-]{8,96}$"
        },
        "sideId": {
          "anyOf": [{ "$ref": "#/$defs/encounterSideId" }, { "type": "null" }]
        },
        "ownerPlacementId": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "mapGroundItemSourceResource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "sheetKind", "slug", "revision"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "sheet" },
            "sheetKind": { "enum": ["pokemon", "trainer"] },
            "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 160 },
            "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "slug", "revision"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["group-inventory", "map"] },
            "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 160 },
            "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        }
      ]
    },
    "encounterSideId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 64
    },
    "encounterSideDirectory": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "$ref": "#/$defs/encounterSideId" },
      "additionalProperties": { "$ref": "#/$defs/encounterSide" }
    },
    "encounterSide": {
      "type": "object",
      "required": ["id", "label", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/encounterSideId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "status": { "enum": ["active", "inactive"] }
      }
    },
    "encounterEffectStableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._:/-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "encounterEffectCanonicalMoveId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?!\\s)(?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])$"
    },
    "encounterEffectSpecHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "encounterEffect": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source",
        "affected",
        "createdRound",
        "createdTurn",
        "duration",
        "stacks",
        "charges",
        "tags",
        "payload",
        "dispel",
        "suppression"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/encounterEffectStableId" },
        "kind": { "enum": ["condition", "numeric-modifier", "capability", "item-suppression", "move-list-overlay"] },
        "source": { "$ref": "#/$defs/encounterEffectSource" },
        "affected": { "$ref": "#/$defs/encounterEffectAffected" },
        "createdRound": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "createdTurn": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "duration": { "$ref": "#/$defs/encounterEffectDuration" },
        "stacks": { "type": "integer", "minimum": 1, "maximum": 64 },
        "charges": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
        "stackPolicy": { "$ref": "#/$defs/encounterEffectStackPolicy" },
        "chargePolicy": { "$ref": "#/$defs/encounterEffectChargePolicy" },
        "transferPolicy": { "enum": ["retain", "expire", "baton-pass"] },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/encounterEffectStableId" }
        },
        "payload": { "type": "object" },
        "dispel": { "$ref": "#/$defs/encounterEffectDispel" },
        "suppression": { "$ref": "#/$defs/encounterEffectSuppression" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "condition" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterConditionEffectPayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "numeric-modifier" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterNumericModifierEffectPayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "capability" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterCapabilityEffectPayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "item-suppression" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterItemSuppressionEffectPayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "move-list-overlay" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterMoveListOverlayEffectPayload" } } }
        }
      ]
    },
    "encounterEffectSource": {
      "type": "object",
      "required": ["operationId", "moveId", "placementId"],
      "additionalProperties": false,
      "properties": {
        "operationId": { "$ref": "#/$defs/encounterEffectStableId" },
        "moveId": { "$ref": "#/$defs/encounterEffectStableId" },
        "placementId": { "$ref": "#/$defs/encounterEffectStableId" }
      }
    },
    "encounterEffectCell": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "y": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "z": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "encounterEffectAffected": {
      "type": "object",
      "required": ["placementIds", "sideIds", "cells"],
      "additionalProperties": false,
      "properties": {
        "placementIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/encounterEffectStableId" }
        },
        "sideIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/encounterSideId" }
        },
        "cells": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/encounterEffectCell" }
        }
      },
      "anyOf": [
        { "properties": { "placementIds": { "minItems": 1 } } },
        { "properties": { "sideIds": { "minItems": 1 } } },
        { "properties": { "cells": { "minItems": 1 } } }
      ]
    },
    "encounterEffectDuration": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "remaining"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "turns" },
            "subject": { "enum": ["source", "target"] },
            "boundary": { "enum": ["start", "end"] },
            "remaining": { "type": "integer", "minimum": 1, "maximum": 1000000 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "remaining"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "rounds" },
            "boundary": { "enum": ["start", "end"] },
            "remaining": { "type": "integer", "minimum": 1, "maximum": 1000000 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "remaining"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["scene", "until-triggered", "permanent"] },
            "remaining": { "type": "null" }
          }
        }
      ]
    },
    "encounterEffectStackPolicy": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "maxStacks"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["replace", "refresh", "independent-instance"] },
            "maxStacks": { "type": "null" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "maxStacks"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "add-stack" },
            "maxStacks": { "type": "integer", "minimum": 1, "maximum": 64 }
          }
        }
      ]
    },
    "encounterEffectChargePolicy": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "amount"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "none" },
            "amount": { "type": "null" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "amount"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "consume-on-trigger" },
            "amount": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        }
      ]
    },
    "encounterEffectDispel": {
      "oneOf": [
        {
          "type": "object",
          "required": ["policy", "tags"],
          "additionalProperties": false,
          "properties": {
            "policy": { "const": "none" },
            "tags": { "type": "array", "maxItems": 0 }
          }
        },
        {
          "type": "object",
          "required": ["policy", "tags"],
          "additionalProperties": false,
          "properties": {
            "policy": { "const": "matching-tags" },
            "tags": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/encounterEffectStableId" }
            }
          }
        }
      ]
    },
    "encounterEffectSuppressionSource": {
      "type": "object",
      "required": ["effectId", "reasonCode"],
      "additionalProperties": false,
      "properties": {
        "effectId": { "$ref": "#/$defs/encounterEffectStableId" },
        "reasonCode": { "$ref": "#/$defs/encounterEffectStableId" }
      }
    },
    "encounterEffectSuppression": {
      "type": "object",
      "required": ["sources"],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/encounterEffectSuppressionSource" }
        }
      }
    },
    "encounterConditionEffectPayload": {
      "type": "object",
      "required": ["conditionId", "action"],
      "additionalProperties": false,
      "properties": {
        "conditionId": { "$ref": "#/$defs/encounterEffectStableId" },
        "action": { "enum": ["apply", "prevent", "suppress"] },
        "saveTiming": { "enum": ["start-turn", "end-turn", null] }
      }
    },
    "encounterNumericModifierEffectPayload": {
      "type": "object",
      "required": ["attribute", "operation", "value", "rounding"],
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "enum": [
            "accuracy",
            "evasion",
            "damage-base",
            "damage",
            "damage-reduction",
            "initiative",
            "movement"
          ]
        },
        "operation": { "enum": ["add", "multiply", "set"] },
        "value": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "rounding": { "enum": ["none", "floor", "round", "ceil"] }
      }
    },
    "encounterCapabilityEffectPayload": {
      "type": "object",
      "required": ["capabilityId", "action"],
      "additionalProperties": false,
      "properties": {
        "capabilityId": { "$ref": "#/$defs/encounterEffectStableId" },
        "action": { "enum": ["grant", "suppress"] },
        "value": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "suppress" } }, "required": ["action"] },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    },
    "encounterItemSuppressionEffectPayload": {
      "type": "object",
      "required": ["familyId", "scope", "itemBindingIds", "blocksUse", "blocksBenefit"],
      "additionalProperties": false,
      "properties": {
        "familyId": { "$ref": "#/$defs/encounterEffectStableId" },
        "scope": { "enum": ["all-equipped", "item-bindings"] },
        "itemBindingIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/encounterEffectStableId" }
        },
        "blocksUse": { "type": "boolean" },
        "blocksBenefit": { "type": "boolean" }
      }
    },
    "encounterMoveListOverlayEffectPayload": {
      "oneOf": [
        {
          "type": "object",
          "required": ["action", "canonicalMoveId", "copiedSpecHash"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "add" },
            "canonicalMoveId": { "$ref": "#/$defs/encounterEffectCanonicalMoveId" },
            "copiedSpecHash": { "$ref": "#/$defs/encounterEffectSpecHash" }
          }
        },
        {
          "type": "object",
          "required": ["action", "replacedCanonicalMoveId", "canonicalMoveId", "copiedSpecHash"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "replace" },
            "replacedCanonicalMoveId": { "$ref": "#/$defs/encounterEffectCanonicalMoveId" },
            "canonicalMoveId": { "$ref": "#/$defs/encounterEffectCanonicalMoveId" },
            "copiedSpecHash": { "$ref": "#/$defs/encounterEffectSpecHash" }
          }
        },
        {
          "type": "object",
          "required": ["action", "canonicalMoveIds"],
          "additionalProperties": false,
          "properties": {
            "action": { "enum": ["disable", "restrict"] },
            "canonicalMoveIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/encounterEffectCanonicalMoveId" }
            }
          }
        }
      ]
    },
    "encounterZone": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source",
        "sideId",
        "geometry",
        "layer",
        "duration",
        "stacking",
        "hooks",
        "modifiers",
        "tags",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/encounterEffectStableId" },
        "kind": {
          "enum": [
            "hazard",
            "weather",
            "terrain",
            "room",
            "smoke",
            "barrier",
            "pledge",
            "vortex",
            "side-condition"
          ]
        },
        "source": { "$ref": "#/$defs/encounterZoneSource" },
        "sideId": {
          "anyOf": [
            { "$ref": "#/$defs/encounterSideId" },
            { "type": "null" }
          ]
        },
        "geometry": { "$ref": "#/$defs/encounterZoneGeometry" },
        "layer": { "type": "integer", "minimum": 1, "maximum": 64 },
        "duration": { "$ref": "#/$defs/encounterEffectDuration" },
        "stacking": { "$ref": "#/$defs/encounterZoneStacking" },
        "fieldPolicy": { "$ref": "#/$defs/encounterGlobalFieldPolicy" },
        "hooks": { "$ref": "#/$defs/encounterZoneHooks" },
        "modifiers": { "$ref": "#/$defs/encounterZoneModifiers" },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/encounterEffectStableId" }
        },
        "payload": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "hazard" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterHazardZonePayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "weather" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterWeatherZonePayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "terrain" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterTerrainZonePayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "room" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterRoomZonePayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "smoke" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterSmokeZonePayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "barrier" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterBarrierZonePayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "pledge" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterPledgeZonePayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "vortex" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterVortexZonePayload" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "side-condition" } }, "required": ["kind"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/encounterSideConditionZonePayload" } } }
        }
      ]
    },
    "encounterZoneSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "operationId", "moveId", "placementId"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "operation" },
            "operationId": { "$ref": "#/$defs/encounterEffectStableId" },
            "moveId": {
              "anyOf": [
                { "$ref": "#/$defs/encounterEffectStableId" },
                { "type": "null" }
              ]
            },
            "placementId": {
              "anyOf": [
                { "$ref": "#/$defs/encounterEffectStableId" },
                { "type": "null" }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "lane", "key"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "legacy-map" },
            "lane": { "enum": ["hazards", "weather", "terrain", "room"] },
            "key": { "$ref": "#/$defs/encounterEffectStableId" }
          }
        }
      ]
    },
    "encounterZoneGeometry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "battlefield" } }
        },
        {
          "type": "object",
          "required": ["kind", "cells"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "cells" },
            "cells": {
              "type": "array",
              "minItems": 1,
              "maxItems": 512,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/encounterEffectCell" }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "placementId"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "placement" },
            "placementId": { "$ref": "#/$defs/encounterEffectStableId" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "sideId"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "side" },
            "sideId": { "$ref": "#/$defs/encounterSideId" }
          }
        }
      ]
    },
    "encounterZoneStacking": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "maxLayers"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["replace", "refresh", "independent"] },
            "maxLayers": { "type": "null" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "maxLayers"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "add-layer" },
            "maxLayers": { "type": "integer", "minimum": 1, "maximum": 64 }
          }
        }
      ]
    },
    "encounterGlobalFieldPolicy": {
      "type": "object",
      "required": ["priority", "replacementGroup", "suppression"],
      "additionalProperties": false,
      "properties": {
        "priority": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
        "replacementGroup": { "$ref": "#/$defs/encounterEffectStableId" },
        "suppression": { "$ref": "#/$defs/encounterGlobalFieldSuppression" }
      }
    },
    "encounterGlobalFieldSuppression": {
      "type": "object",
      "required": ["sources"],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/encounterGlobalFieldSuppressionSource" }
        }
      }
    },
    "encounterGlobalFieldSuppressionSource": {
      "type": "object",
      "required": ["zoneId", "reasonCode"],
      "additionalProperties": false,
      "properties": {
        "zoneId": { "$ref": "#/$defs/encounterEffectStableId" },
        "reasonCode": { "$ref": "#/$defs/encounterEffectStableId" }
      }
    },
    "encounterZoneHooks": {
      "type": "object",
      "required": ["entry", "exit"],
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/encounterZoneHook" }
        },
        "exit": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/encounterZoneHook" }
        }
      }
    },
    "encounterZoneHook": {
      "type": "object",
      "required": ["id", "handlerId", "oncePerMovement"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/encounterEffectStableId" },
        "handlerId": { "$ref": "#/$defs/encounterEffectStableId" },
        "oncePerMovement": { "type": "boolean" }
      }
    },
    "encounterZoneModifiers": {
      "type": "object",
      "required": ["targeting", "damage", "movement"],
      "additionalProperties": false,
      "properties": {
        "targeting": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/encounterZoneModifier" }
        },
        "damage": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/encounterZoneModifier" }
        },
        "movement": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/encounterZoneModifier" }
        }
      }
    },
    "encounterZoneModifier": {
      "type": "object",
      "required": ["id", "attribute", "operation", "value", "reasonCode"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/encounterEffectStableId" },
        "attribute": {
          "enum": [
            "accuracy",
            "evasion",
            "cover",
            "line-of-sight",
            "damage-base",
            "damage",
            "damage-reduction",
            "cost",
            "budget",
            "traversal"
          ]
        },
        "operation": { "enum": ["add", "multiply", "set", "block"] },
        "value": {
          "type": ["number", "null"],
          "minimum": -1000000,
          "maximum": 1000000
        },
        "reasonCode": { "$ref": "#/$defs/encounterEffectStableId" }
      }
    },
    "encounterHazardZonePayload": {
      "type": "object",
      "required": ["hazardId"],
      "additionalProperties": false,
      "dependentRequired": {
        "familyId": ["charges", "maxCharges"],
        "charges": ["familyId", "maxCharges"],
        "maxCharges": ["familyId", "charges"]
      },
      "properties": {
        "hazardId": { "$ref": "#/$defs/encounterEffectStableId" },
        "familyId": { "$ref": "#/$defs/encounterEffectStableId" },
        "charges": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
        "maxCharges": { "type": ["integer", "null"], "minimum": 1, "maximum": 10000 }
      }
    },
    "encounterWeatherZonePayload": {
      "type": "object",
      "required": ["weatherId"],
      "additionalProperties": false,
      "properties": { "weatherId": { "$ref": "#/$defs/encounterEffectStableId" } }
    },
    "encounterTerrainZonePayload": {
      "type": "object",
      "required": ["terrainId"],
      "additionalProperties": false,
      "properties": { "terrainId": { "$ref": "#/$defs/encounterEffectStableId" } }
    },
    "encounterRoomZonePayload": {
      "type": "object",
      "required": ["roomId", "startsNextRound"],
      "additionalProperties": false,
      "properties": {
        "roomId": { "$ref": "#/$defs/encounterEffectStableId" },
        "startsNextRound": { "type": "boolean" }
      }
    },
    "encounterSmokeZonePayload": {
      "type": "object",
      "required": ["smokeId"],
      "additionalProperties": false,
      "properties": { "smokeId": { "$ref": "#/$defs/encounterEffectStableId" } }
    },
    "encounterBarrierZonePayload": {
      "type": "object",
      "required": ["barrierId"],
      "additionalProperties": false,
      "dependentRequired": {
        "currentHitPoints": ["maximumHitPoints", "damageReduction", "height", "typeIds"],
        "maximumHitPoints": ["currentHitPoints", "damageReduction", "height", "typeIds"],
        "damageReduction": ["currentHitPoints", "maximumHitPoints", "height", "typeIds"],
        "height": ["currentHitPoints", "maximumHitPoints", "damageReduction", "typeIds"],
        "typeIds": ["currentHitPoints", "maximumHitPoints", "damageReduction", "height"]
      },
      "properties": {
        "barrierId": { "$ref": "#/$defs/encounterEffectStableId" },
        "currentHitPoints": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximumHitPoints": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "damageReduction": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 32 },
        "typeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$", "maxLength": 160 }
        }
      }
    },
    "encounterPledgeZonePayload": {
      "type": "object",
      "required": ["pledgeId"],
      "additionalProperties": false,
      "dependentRequired": {
        "familyId": ["charges", "maxCharges"],
        "charges": ["familyId", "maxCharges"],
        "maxCharges": ["familyId", "charges"]
      },
      "properties": {
        "pledgeId": { "$ref": "#/$defs/encounterEffectStableId" },
        "familyId": { "$ref": "#/$defs/encounterEffectStableId" },
        "charges": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
        "maxCharges": { "type": ["integer", "null"], "minimum": 1, "maximum": 10000 }
      }
    },
    "encounterVortexZonePayload": {
      "type": "object",
      "required": ["vortexId"],
      "additionalProperties": false,
      "properties": { "vortexId": { "$ref": "#/$defs/encounterEffectStableId" } }
    },
    "encounterSideConditionZonePayload": {
      "type": "object",
      "required": ["conditionId"],
      "additionalProperties": false,
      "properties": { "conditionId": { "$ref": "#/$defs/encounterEffectStableId" } }
    },
    "pendingMoveResolutionPublicSummary": {
      "type": "object",
      "required": [
        "schemaVersion",
        "resolutionId",
        "actorPlacementId",
        "canonicalMoveId",
        "phase",
        "status",
        "outstandingWindowCount",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "resolutionId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "actorPlacementId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "canonicalMoveId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "phase": {
          "enum": [
            "declare",
            "precondition",
            "pay",
            "target",
            "pre-hit",
            "accuracy",
            "hit",
            "miss",
            "damage",
            "after-damage",
            "ko",
            "movement",
            "schedule",
            "usage",
            "cleanup"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "resuming",
            "committed",
            "cancelled",
            "expired",
            "conflicted",
            "abandoned"
          ]
        },
        "outstandingWindowCount": { "type": "integer", "minimum": 0, "maximum": 64 },
        "createdAt": { "type": "integer", "minimum": 0 },
        "updatedAt": { "type": "integer", "minimum": 0 }
      }
    },
    "emptyEncounterDirectory": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    }
  }
}
