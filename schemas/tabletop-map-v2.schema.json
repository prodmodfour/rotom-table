{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotom-table.local/schemas/tabletop-map-v2.schema.json",
  "title": "Rotom Table TabletopMap v2",
  "type": "object",
  "required": ["schemaVersion", "slug", "name", "dimensions", "voxels", "placements"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "folder": { "type": "string" },
    "dimensions": { "$ref": "#/$defs/dimensions" },
    "voxels": { "type": "array", "items": { "$ref": "#/$defs/voxel" } },
    "placements": { "type": "array", "items": { "$ref": "#/$defs/placement" } },
    "lights": { "type": "array", "items": { "$ref": "#/$defs/light" } },
    "initiative": { "$ref": "#/$defs/initiative" },
    "metadata": { "type": "object", "additionalProperties": true },
    "createdAt": { "type": "number" },
    "updatedAt": { "type": "number" }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 1, "maximum": 200 },
        "y": { "type": "integer", "minimum": 1, "maximum": 200 },
        "z": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "anchor": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "voxel": {
      "type": "object",
      "required": ["x", "y", "z", "materialId"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" },
        "materialId": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#?[0-9a-fA-F]{6}$" },
        "blocksMovement": { "type": "boolean" },
        "blocksSight": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "placement": {
      "type": "object",
      "required": ["id", "sheetKind", "sheetSlug", "position"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "sheetKind": { "enum": ["pokemon", "trainer"] },
        "sheetSlug": { "type": "string" },
        "position": { "$ref": "#/$defs/anchor" },
        "initiative": { "type": ["integer", "null"] },
        "turned": { "type": "boolean" }
      }
    },
    "light": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["ambient", "point", "emissive", "zone"] },
        "position": { "$ref": "#/$defs/anchor" },
        "color": { "type": "string", "pattern": "^#?[0-9a-fA-F]{6}$" },
        "intensity": { "type": "number" },
        "radius": { "type": "number" },
        "zoneId": { "type": "string" }
      }
    },
    "initiative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activeId": { "type": ["string", "null"] },
        "round": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
