{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotom-table.local/schemas/tabletop-map-v2.schema.json",
  "title": "Rotom Table TabletopMap v2",
  "type": "object",
  "required": ["schemaVersion", "slug", "name", "dimensions", "voxels", "placements"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "folder": { "type": "string" },
    "dimensions": { "$ref": "#/$defs/dimensions" },
    "assetPacks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "voxels": { "type": "array", "items": { "$ref": "#/$defs/voxel" } },
    "placements": { "type": "array", "items": { "$ref": "#/$defs/placement" } },
    "decals": { "type": "array", "items": { "$ref": "#/$defs/decal" } },
    "props": { "type": "array", "items": { "$ref": "#/$defs/prop" } },
    "zones": { "type": "array", "items": { "$ref": "#/$defs/zone" } },
    "doors": { "type": "array", "items": { "$ref": "#/$defs/door" } },
    "lights": { "type": "array", "items": { "$ref": "#/$defs/light" } },
    "initiative": { "$ref": "#/$defs/initiative" },
    "metadata": { "type": "object", "additionalProperties": true },
    "createdAt": { "type": "number" },
    "updatedAt": { "type": "number" }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 1, "maximum": 200 },
        "y": { "type": "integer", "minimum": 1, "maximum": 200 },
        "z": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "anchor": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "voxel": {
      "type": "object",
      "required": ["x", "y", "z", "materialId"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" },
        "materialId": { "type": "string" },
        "color": { "type": "string", "pattern": "^#?[0-9a-fA-F]{6}$" },
        "blocksMovement": { "type": "boolean" },
        "blocksSight": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "placement": {
      "type": "object",
      "required": ["id", "sheetKind", "sheetSlug", "position"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "sheetKind": { "enum": ["pokemon", "trainer"] },
        "sheetSlug": { "type": "string" },
        "position": { "$ref": "#/$defs/anchor" },
        "initiative": { "type": ["integer", "null"] },
        "turned": { "type": "boolean" }
      }
    },
    "decal": {
      "type": "object",
      "required": ["id", "decalId", "surface", "position"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "decalId": { "type": "string" },
        "surface": { "enum": ["floor", "ceiling", "north", "south", "east", "west"] },
        "position": { "$ref": "#/$defs/anchor" },
        "rotation": { "type": "number" },
        "scale": {
          "type": "object",
          "required": ["x", "z"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "exclusiveMinimum": 0 },
            "y": { "type": "number", "exclusiveMinimum": 0 },
            "z": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "tint": { "type": "string", "pattern": "^#?[0-9a-fA-F]{6}$" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "renderOrder": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "prop": {
      "type": "object",
      "required": ["id", "propId", "position"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "propId": { "type": "string" },
        "position": { "$ref": "#/$defs/anchor" },
        "rotation": { "type": "number" },
        "scale": {
          "oneOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "object", "required": ["x", "y", "z"], "additionalProperties": false, "properties": { "x": { "type": "number", "exclusiveMinimum": 0 }, "y": { "type": "number", "exclusiveMinimum": 0 }, "z": { "type": "number", "exclusiveMinimum": 0 } } }
          ]
        },
        "footprint": { "type": "object", "required": ["x", "z"], "additionalProperties": false, "properties": { "x": { "type": "number", "exclusiveMinimum": 0 }, "z": { "type": "number", "exclusiveMinimum": 0 } } },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "anchor": { "enum": ["center", "bottom-center", "grid-cell"] },
        "blocksMovement": { "type": "boolean" },
        "blocksSight": { "type": "boolean" },
        "interactable": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "zone": {
      "type": "object",
      "required": ["id", "name", "bounds"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "bounds": { "type": "object", "required": ["x1", "z1", "x2", "z2"], "additionalProperties": false, "properties": { "x1": { "type": "number" }, "y1": { "type": "number" }, "z1": { "type": "number" }, "x2": { "type": "number" }, "y2": { "type": "number" }, "z2": { "type": "number" } } },
        "theme": { "type": "string" },
        "icon": { "type": "string" },
        "tint": { "type": "string", "pattern": "^#?[0-9a-fA-F]{6}$" },
        "borderStyle": { "type": "string" },
        "ambientLight": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "door": {
      "type": "object",
      "required": ["id", "doorId", "position"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "doorId": { "type": "string" },
        "position": { "$ref": "#/$defs/anchor" },
        "rotation": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "state": { "enum": ["open", "closed", "locked"] },
        "connectsTo": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "light": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["ambient", "point", "emissive", "zone"] },
        "position": { "$ref": "#/$defs/anchor" },
        "color": { "type": "string", "pattern": "^#?[0-9a-fA-F]{6}$" },
        "intensity": { "type": "number" },
        "radius": { "type": "number" },
        "zoneId": { "type": "string" }
      }
    },
    "initiative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activeId": { "type": ["string", "null"] },
        "round": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
