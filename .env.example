# Optional: point Rotom Table at a private campaign workspace/repo.
# Relative paths are resolved from the app checkout; ~/ is also supported.
# ROTOM_CAMPAIGN_ROOT=../my-rotom-campaign

# Optional: override the live-play SQLite database path.
# By default this is rotom-table.sqlite under ROTOM_CAMPAIGN_ROOT.
# Relative paths here are resolved under ROTOM_CAMPAIGN_ROOT.
# ROTOM_DB_PATH=rotom-table.sqlite
