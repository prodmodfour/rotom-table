  "reviewDecisions": [
    {
      "id": "P11-CONTEST-DATA-001",
      "decision": "Structured is an authority-ready intermediate completion state, not a selectable native runtime state. Phase 6 and Phase 7 advance each row to native only after its engine certification."
    },
    {
      "id": "P11-CONTEST-DATA-002",
      "decision": "Trainer Participant supports the two printed methods: both performers appeal with controller-chosen order and separate Voltage, or performers alternate with shared Voltage. Both methods share one entry Contest Stat Dice pool."
    },
    {
      "id": "P11-CONTEST-DATA-003",
      "decision": "Battle Contest core scale is two Trainers with an equal declared roster of three through six Pokémon each and a six-through-twelve-round budget equal to twice that roster count. Optional double/triple battle advice does not create an additional runtime format."
    },
    {
      "id": "P11-CONTEST-DATA-004",
      "decision": "Only accepted Move results produce Battle Contest appeals. Struggle Attacks and Combat Maneuvers are excluded; all opposing field Pokémon are adjacent for Contest effects."
    },
    {
      "id": "P11-CONTEST-DATA-005",
      "decision": "Battle Voltage is per Pokémon; attack KOs grant two, damage-over-time KOs redirect two to the opposing active Pokémon, ordinary recall loses two, and the four printed switch exception identities do not lose Voltage."
    }
  ],
