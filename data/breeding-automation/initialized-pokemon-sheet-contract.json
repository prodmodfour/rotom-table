  "definition": {
    "version": 1,
    "repositoryPath": "server/storage/initializedPokemonSheetRepository.ts",
    "insert": {
      "kind": "pokemon",
      "revision": 0,
      "placeholderWrite": "forbidden",
      "writesPerChild": 1,
      "authorityFieldsAssignedByStorage": [
        "slug",
        "folder",
        "revision",
        "createdAt",
        "updatedAt"
      ],
      "completeDocumentRequiredBeforeInsert": true
    },
    "candidate": {
      "plainJsonOnly": true,
      "unknownFields": "reject",
      "accessorsSymbolsSparseOrEnrichedValues": "reject",
      "currentNormalization": "must-already-be-exact",
      "requiredHeadlineFacts": [
        "nickname",
        "species",
        "level",
        "totalExp",
        "gender",
        "loyalty",
        "shiny",
        "caughtBall",
        "player",
        "nature",
        "babyTemplate",
        "combat.currentHp",
        "abilities",
        "inheritedRemaining",
        "tutorPoints.earned",
        "serverPrivate.breedingProviderTraits.coreHatchRules",
        "serverPrivate.breedingProviderTraits.fossilRestoration",
        "serverPrivate.breedingProviderTraits.prehistoricBond",
        "babyTemplateMechanics-when-applied",
        "serverPrivate.breedingBabyTemplate-when-applied",
        "serverPrivate.breedingProviderTraits.marsupial",
        "serverPrivate.breedingProviderTraits.playingGod"
      ],
      "newbornAppliedMoves": 0,
      "newbornPokeEdges": 0,
      "serverPrivate": "exact-core-hatch-rule-and-closed-nullable-Serpents-Mark-fossil-Marsupial-and-Playing-God-provider-traits-plus-self-hashed-Baby-Template-authority",
      "babyTemplate": "private-authority-and-owner-safe-mechanics-must-match-exactly; editable-boolean-alone-is-never-authority"
    },
    "canonicalReferences": {
      "species": "data/reference/pokedex.json exact display identity",
      "moves": "data/reference/moves.json exact identity",
      "abilities": "data/reference/abilities.json exact identity",
      "natures": "data/breeding-automation/natures.json exact reviewed label",
      "supplementaryRuntimeSources": "forbidden"
    },
    "slugAllocation": {
      "scope": "pokemon-sheet-kind",
      "strategy": "slugified-root-then-monotonic-numeric-suffix",
      "rootMaximumCharacters": 140,
      "maximumAttempts": 10000,
      "conflictDetection": "primary-key-insert-then-existing-row-verification",
      "trainerSlugCollision": "independent-kind-does-not-collide",
      "blankFallback": "hatched-pokemon"
    },
    "transaction": {
      "standalone": "BEGIN-IMMEDIATE",
      "callerOwnedParticipation": true,
      "independentNestedCommit": "forbidden",
      "failedAttemptIsolation": "SQLite-savepoint",
      "insertAndFolderIndex": "atomic",
      "failureLeavesPlaceholder": false
    },
    "retry": {
      "sameHatchOperation": "owned-by-terminal-operation-and-Egg-coordinator",
      "repositoryCreatesSecondChildOnExactOperationReplay": "must-not-be-invoked",
      "differentOperationsWithSameName": "allocate-distinct-slugs"
    },
    "privacy": {
      "document": "server-private-unprojected",
      "errors": "field-and-policy-only-no-payload",
      "localPersistence": "none"
    },
    "authority": {
      "mapDependency": "none",
      "encounterDependency": "none",
      "eggSheetKind": "none",
      "browserWrite": "none",
      "childKindCount": 1,
      "trainerKindCount": 1
    },
    "bindings": {
      "storageSchemaDefinitionSha256": "696d5e9139086dfeef0eae60340d871ffb685cd0814349e05094b4b074b75a89",
      "repositoryContractDefinitionSha256": "d15c11f9f360d1ebd603feee8ec1506be9262d58f20bc9f753f5af979fa823b5",
