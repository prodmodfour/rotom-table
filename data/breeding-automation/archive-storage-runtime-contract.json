{
  "schemaVersion": 1,
  "contractId": "rotom-breeding-archive-storage-runtime-v1",
  "rulesetId": "ptu-1.05-breeding-v1",
  "rulesetDefinitionSha256": "ab778e2ca678e8f823b78c2f2bec883ec6796b730d4996e24e5c07d40f6fea02",
  "sourceManifestSha256": "fddf4a3cb4a3806eab4e65b6b8090a0cc42beb261353060b8d9492806d965bb7",
  "definitionSha256": "500c5b07a93b92fc1d6a642b5c8124483c1d2106c12bc073e7b4766394b25e77",
  "definition": {
    "version": 1,
    "repositoryPaths": [
      "server/storage/breedingArchiveRepository.ts",
      "server/storage/breedingArchiveStateRepository.ts"
    ],
    "managerPath": "server/useCases/manageBreedingArchives.ts",
    "schemaArtifactPath": "data/breeding-automation/archive-storage-schema-v23.json",
    "storage": {
      "schemaVersion": 23,
      "archives": "immutable-strict-stable-json",
      "importRequests": "immutable-strict-stable-json",
      "restoreReceipts": "one-terminal-decision-per-request",
      "identityReplay": "exact-only",
      "identityFactDrift": "reject",
      "maximumEnvelopeBytes": 67108864,
      "denormalizedColumns": "validated-against-strict-authoritative-document",
      "restartPersistence": true
    },
    "export": {
      "campaignBackup": "complete-terminal-authority-record-set",
      "gmAudit": "strict-read-only-authority-record-set",
      "ownerPortable": "server-projected-owner-and-participant-records-only",
      "ownerPortableRestore": "forbidden",
      "pendingCampaignOperation": "backup-blocker",
      "unsupportedPrivateEvidence": "fail-closed-never-omit",
      "consistentSnapshot": "BEGIN-IMMEDIATE-single-connection",
      "campaignClockCheckpoint": "archive-created-minute-must-equal-authoritative-campaign-minute",
      "browserAuthority": "none"
    },
    "restore": {
      "acceptedPurpose": "campaign-backup-only",
      "authority": "current-authenticated-GM-bound-request",
      "referenceVersions": "exact-current-match",
      "recordDependencies": "server-validated-all-records",
      "replacementCheckpoint": "persisted-current-backup-and-unchanged-state-required",
      "newCampaignTarget": "empty-breeding-authority-required",
      "transaction": "archive-request-authority-replacement-and-receipt-one-BEGIN-IMMEDIATE",
      "failure": "rollback-all",
      "foreignKeys": "deferred-and-checked-at-top-level-commit",
      "exactRequestReplay": "return-stored-receipt-without-replacement",
      "operationIdentity": "command-result-read-set-authorization-and-scope-records-preserved",
      "projectEggCycle": "restored-inside-one-deferred-foreign-key-transaction",
      "legacyMapMetadata": "never-imported-or-interpreted"
    },
    "integrity": {
      "audience": "authenticated-GM-only",
      "sqliteIntegrityCheck": true,
      "foreignKeyCheck": true,
      "strictDocumentAndHashReparse": true,
      "maximumDiagnostics": 10000,
      "missingLinks": [
        "owner-trainer",
        "breeder-trainer",
        "parent-pokemon",
        "hatched-child-pokemon",
        "hatched-Egg-origin",
        "origin-Egg-child",
        "acquisition-trainer"
      ],
      "backupBlockers": [
        "corrupt-authority-row",
        "foreign-key-violation",
        "missing-link",
        "pending-operation",
        "unrepresentable-private-evidence"
      ],
      "legacyMapEggMetadata": "warning-only-quarantine-never-authority",
      "report": "stable-json-SHA-256-bound"
    },
    "strictness": {
      "nonPlainOrUnknownArchiveInput": "reject",
      "oversizedEnvelopeBeforeJsonParse": "reject",
      "invalidUtf8OrJson": "reject",
      "asynchronousAuthorizationDependencyOrHook": "reject",
      "nestedTransactionBoundary": "reject",
      "mixedDatabaseConnection": "impossible-manager-owned-repositories",
      "staleActorOrCheckpoint": "reject",
      "changedReplayFacts": "reject"
    },
    "bindings": {
      "archiveContractDefinitionSha256": "791c7236517655fb02eaa598865bd51b9391173be39b8eea6b0995da67af11e2",
      "archiveStorageSchemaV23DefinitionSha256": "236726ef662682f290cd267e988e84b87b86f9390bb74f7c59b92291c38c0803",
      "storageSchemaV22DefinitionSha256": "0da2fb267112523d86bc1d248080a782d1778d02eacece447e91ca64c412a934",
      "repositoryContractDefinitionSha256": "a49fbb1583b2eb417a781a11c2f843d072fec219a78a61cae885d77e721b1c7f",
      "transactionCoordinatorDefinitionSha256": "88ecb3938b35fa1c3bf9247e389cfd85b879d7acbc50f242ad5923993bd1f3ea"
    }
  }
}
