      "foreignKeys": "deferred-and-checked-at-top-level-commit",
      "exactRequestReplay": "return-stored-receipt-without-replacement",
      "operationIdentity": "command-result-complete-read-set-authorization-GM-override-and-scope-records-preserved",
      "projectEggCycle": "restored-inside-one-deferred-foreign-key-transaction",
      "legacyMapMetadata": "never-imported-or-interpreted",
      "externalSpeciesAcquisition": "source-settlements-preserved-without-forged-Breeding-commands",
      "eggTransferConsent": "dual-consent-history-preserved-exactly"
