          "sha256": "0a101802a698403651756b19e9cc6a10b8c6e2c91cfa9b79be1bcb1e7aa60082"
        }
      ],
      "decision": "Fossils create the same durable Egg aggregate with source kind fossil. Default hatch Level is 10; traits are bounded GM choices; parent inheritance is absent unless a bounded canonical list is explicitly supplied. No parallel fossil hatch path is allowed.",
      "defaultPolicyId": "shared-egg-lifecycle",
      "campaignOptionIds": [
        "breeding.fossil-hatch-level",
        "breeding.fossil-inheritance-policy"
