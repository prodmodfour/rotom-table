  "entries": [
    {
      "id": "BR-SRC-001",
      "conflictId": "parent-family-selection",
      "sourceEvidence": [
        {
          "path": "books/markdown/core/05-pokemon.md",
          "sha256": "4fa04ea5d56b04a95ddfaea55cf096166d0bdd71b318ed9f64dbbce583b47eb3"
        },
        {
          "path": "books/markdown/pokedexes/how-to-read.md",
          "sha256": "e27cc5f5b3b7f059244f404b8037a0a50dcc575b0ec0aa765602d23023f6fb02"
        }
      ],
      "decision": "Use the core 1d20 female-versus-male family selector first, then resolve the selected family to its reviewed lowest-stage form root. The maternal-line guide does not replace the core selector.",
      "defaultPolicyId": "core-d20",
      "campaignOptionIds": [
        "breeding.parent-family-policy"
      ],
      "failureMode": "unavailable-with-stable-diagnostic",
      "status": "accepted"
    },
    {
      "id": "BR-SRC-002",
      "conflictId": "lowest-stage-and-form-root",
      "sourceEvidence": [
        {
          "path": "data/reference/pokedex.json",
          "sha256": "ca62ed2a9b934bc8d66c75d198b200035c37a9ade13239fc0129169a8deaa696"
        },
        {
          "path": "books/markdown/pokedexes/how-to-read.md",
          "sha256": "e27cc5f5b3b7f059244f404b8037a0a50dcc575b0ec0aa765602d23023f6fb02"
        }
      ],
      "decision": "Resolve only through a compiled, acyclic, source-hash-bound family/form graph. A missing, cyclic, condition-suffixed, alias-only, or multi-root path is unavailable until a reviewed app-owned adjudication names the exact root.",
      "defaultPolicyId": "reviewed-lowest-stage-form-root",
      "campaignOptionIds": [
        "breeding.form-root-policy"
      ],
      "failureMode": "unavailable-with-stable-diagnostic",
      "status": "accepted",
      "canonicalDiagnostic": {
        "unknownEvolutionTargetCount": 127,
        "unknownEvolutionReferenceCount": 254,
        "selfStageMismatchRecordCount": 167
      }
    },
    {
      "id": "BR-SRC-003",
      "conflictId": "ditto-identity-and-group",
      "sourceEvidence": [
        {
          "path": "data/reference/pokedex.json",
          "sha256": "ca62ed2a9b934bc8d66c75d198b200035c37a9ade13239fc0129169a8deaa696"
        },
        {
          "path": "books/markdown/pokedexes/how-to-read.md",
          "sha256": "e27cc5f5b3b7f059244f404b8037a0a50dcc575b0ec0aa765602d23023f6fb02"
        }
      ],
      "decision": "Only canonical species ID ditto receives the either-parent-role rule. An Egg Group label alone never grants Ditto behavior; Ditto never supplies the offspring family; Ditto with Ditto is incompatible. Any non-Ditto row carrying the Ditto label requires a species adjudication.",
      "defaultPolicyId": "canonical-ditto-species-only",
      "campaignOptionIds": [
        "breeding.genderless-policy"
      ],
      "failureMode": "unavailable-with-stable-diagnostic",
      "status": "accepted",
      "canonicalDiagnostic": {
        "dittoEggGroupRows": [
          "Ditto",
          "Mew"
        ]
      }
    },
    {
      "id": "BR-SRC-004",
      "conflictId": "genderless-and-parent-roles",
      "sourceEvidence": [
        {
          "path": "data/reference/pokedex.json",
          "sha256": "ca62ed2a9b934bc8d66c75d198b200035c37a9ade13239fc0129169a8deaa696"
        },
        {
          "path": "books/markdown/pokedexes/how-to-read.md",
          "sha256": "e27cc5f5b3b7f059244f404b8037a0a50dcc575b0ec0aa765602d23023f6fb02"
        }
      ],
      "decision": "Conventional breeding requires one female-role and one male-role parent. Genderless Pokémon are unavailable by default except canonical Ditto. A GM may use only the typed, audited role-override operation; free-form gender labels never authorize compatibility.",
      "defaultPolicyId": "ditto-only",
      "campaignOptionIds": [
        "breeding.genderless-policy",
        "breeding.same-sex-policy"
      ],
      "failureMode": "unavailable-with-stable-diagnostic",
      "status": "accepted",
      "canonicalDiagnostic": {
        "genderlessRecordCount": 160
      }
    },
    {
      "id": "BR-SRC-005",
      "conflictId": "undefined-maturity-threshold",
      "sourceEvidence": [
        {
          "path": "data/reference/pokedex.json",
          "sha256": "ca62ed2a9b934bc8d66c75d198b200035c37a9ade13239fc0129169a8deaa696"
        },
        {
          "path": "books/markdown/pokedexes/how-to-read.md",
          "sha256": "e27cc5f5b3b7f059244f404b8037a0a50dcc575b0ec0aa765602d23023f6fb02"
        }
      ],
      "decision": "The default requires an explicit bounded GM maturity confirmation for each parent at project creation. No level, evolution stage, editable note, or browser inference implies maturity. Campaigns may instead freeze a 1–100 minimum Level.",
      "defaultPolicyId": "gm-confirmed-per-parent",
      "campaignOptionIds": [
        "breeding.maturity-policy",
        "breeding.minimum-maturity-level"
      ],
      "failureMode": "unavailable-with-stable-diagnostic",
      "status": "accepted"
    },
    {
      "id": "BR-SRC-006",
      "conflictId": "egg-group-vocabulary-drift",
      "sourceEvidence": [
        {
          "path": "data/reference/pokedex.json",
          "sha256": "ca62ed2a9b934bc8d66c75d198b200035c37a9ade13239fc0129169a8deaa696"
        },
        {
          "path": "books/markdown/pokedexes/how-to-read.md",
          "sha256": "e27cc5f5b3b7f059244f404b8037a0a50dcc575b0ec0aa765602d23023f6fb02"
        }
      ],
      "decision": "Compile reviewed aliases into stable Egg Group IDs; split composite source cells only through an exact adjudication. Runtime string comparison and silent synonym inference are forbidden.",
      "defaultPolicyId": "compiled-egg-group-taxonomy",
      "campaignOptionIds": [],
      "failureMode": "unavailable-with-stable-diagnostic",
      "status": "accepted",
      "canonicalDiagnostic": {
        "distinctSourceValues": 19,
