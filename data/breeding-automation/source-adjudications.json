          "sha256": "f5aa0b4eedfc7ad07e0db38a79023b5b38c1697a325929ad282f4285cebbaf8a"
        }
      ],
      "decision": "The Baby Template is disabled by default. If enabled per Egg, the server freezes a 2–4 Base Stat penalty and typed skill, capability, size, and growth effects; editable babyTemplate alone is never origin evidence.",
      "defaultPolicyId": "disabled",
      "campaignOptionIds": [
        "breeding.baby-template-policy",
        "breeding.baby-template-stat-penalty"
