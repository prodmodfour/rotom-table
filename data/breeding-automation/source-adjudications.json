          "sha256": "e27cc5f5b3b7f059244f404b8037a0a50dcc575b0ec0aa765602d23023f6fb02"
        }
      ],
      "decision": "Parse exact app-owned N Days values to campaign minutes during compilation. The default uses the fixed average. Optional variation is one persisted server roll or one bounded audited GM value between one-half and twice the average, snapshotted at Egg acceptance.",
      "defaultPolicyId": "fixed-average",
      "campaignOptionIds": [
        "breeding.hatch-duration-variation"
      ],
      "failureMode": "unavailable-with-stable-diagnostic",
      "status": "accepted",
      "canonicalDiagnostic": {
        "recognizedSourceValues": [
          "2 Days",
          "4 Days",
          "7 Days",
          "10 Days",
          "13 Days",
          "16 Days",
          "20 Days",
          "25 Days",
          "40 Days",
          "75 Days"
        ]
      }
    },
    {
      "id": "BR-SRC-009",
      "conflictId": "missing-hatch-duration",
      "sourceEvidence": [
        {
          "path": "data/reference/pokedex.json",
          "sha256": "ca62ed2a9b934bc8d66c75d198b200035c37a9ade13239fc0129169a8deaa696"
        }
      ],
      "decision": "A missing or malformed hatch duration is unavailable. A GM may provide bounded campaign minutes only through the typed source-gap override, and the Egg freezes that override and audit evidence.",
      "defaultPolicyId": "unavailable",
      "campaignOptionIds": [
        "breeding.missing-hatch-duration-policy",
        "breeding.gm-hatch-duration-minutes"
      ],
      "failureMode": "unavailable-with-stable-diagnostic",
      "status": "accepted",
      "canonicalDiagnostic": {
        "missingHatchRateRecordCount": 598
      }
    },
    {
      "id": "BR-SRC-010",
      "conflictId": "special-hatch-not-automatic-shiny",
      "sourceEvidence": [
        {
          "path": "books/markdown/core/05-pokemon.md",
          "sha256": "4fa04ea5d56b04a95ddfaea55cf096166d0bdd71b318ed9f64dbbce583b47eb3"
        },
        {
          "path": "data/reference/features.json",
          "sha256": "27d0f2bee4db96ebfb0c431cce9ea5222fe3d2d9fe9ead32507c46b51a9d77c4"
        }
      ],
      "decision": "Roll 1d100 once at hatch. Results 1 and 100 open a bounded GM adjudication by default; they do not set Shiny automatically. A configured bounded table may replace the GM decision, and authoritative providers may force the same workflow without changing its authority.",
      "defaultPolicyId": "bounded-gm-adjudication",
      "campaignOptionIds": [
        "breeding.hatch-special-policy"
      ],
      "failureMode": "unavailable-with-stable-diagnostic",
      "status": "accepted"
    },
    {
      "id": "BR-SRC-011",
      "conflictId": "optional-baby-template",
      "sourceEvidence": [
        {
          "path": "books/markdown/core/05-pokemon.md",
          "sha256": "4fa04ea5d56b04a95ddfaea55cf096166d0bdd71b318ed9f64dbbce583b47eb3"
