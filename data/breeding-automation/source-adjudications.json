          "Ground",
          "Humanshape",
          "Human-Like",
          "Indeterminate",
          "Amorphous",
          "Plant",
          "Grass",
          "Field, Human-Like"
        ]
      }
    },
    {
      "id": "BR-SRC-007",
      "conflictId": "missing-egg-group-versus-no-breeding",
      "sourceEvidence": [
        {
          "path": "data/reference/pokedex.json",
          "sha256": "ca62ed2a9b934bc8d66c75d198b200035c37a9ade13239fc0129169a8deaa696"
        }
      ],
      "decision": "Absence of Egg Groups is not automatically interpreted as No Breeding. The compiled registry must classify each row as breedable, no-breeding, or excluded-source-gap through a source-bound species adjudication.",
      "defaultPolicyId": "explicit-breeding-eligibility",
      "campaignOptionIds": [],
      "failureMode": "unavailable-with-stable-diagnostic",
      "status": "accepted",
      "canonicalDiagnostic": {
        "missingEggGroupRecordCount": 248
      }
    },
    {
      "id": "BR-SRC-008",
      "conflictId": "hatch-duration-average-and-variation",
      "sourceEvidence": [
        {
          "path": "data/reference/pokedex.json",
          "sha256": "ca62ed2a9b934bc8d66c75d198b200035c37a9ade13239fc0129169a8deaa696"
