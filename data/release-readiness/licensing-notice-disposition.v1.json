  "recommendations": [
    {
      "number": 1,
      "recommendation": "Keep the limited MIT grant and unofficial non-commercial fan-project posture.",
      "decision": "ACCEPTED_IMPLEMENTED"
    },
    {
      "number": 2,
      "recommendation": "Keep Pokémon/PTU-derived data, text, names, and concepts outside the Rotom Table license grant.",
      "decision": "ACCEPTED_IMPLEMENTED"
    },
    {
      "number": 3,
      "recommendation": "Retain the primary item, Pokémon, and Trainer sprite libraries with source and artist attribution where available and with redistribution uncertainty disclosed.",
      "decision": "ACCEPTED_IMPLEMENTED"
    },
    {
      "number": 4,
      "recommendation": "Remove the 29 unknown-source badge, favicon, saving-icon, and water-texture images and replace their runtime functions with original project work.",
      "decision": "ACCEPTED_IMPLEMENTED"
    },
    {
      "number": 5,
      "recommendation": "Remove or replace the 1,460 edited Trainer profile portraits that conflict with the source index do-not-edit warning.",
      "decision": "DECLINED_OWNER_ACCEPTED_RISK",
      "riskNotCuredByNotice": true
    },
    {
      "number": 6,
      "recommendation": "Preserve OFL font notices and lock-bound npm dependency notices in the source and production distributions.",
      "decision": "ACCEPTED_IMPLEMENTED"
    },
    {
      "number": 7,
      "recommendation": "Pin the complete Python helper dependency graph to exact versions and record its licenses.",
      "decision": "ACCEPTED_IMPLEMENTED"
    },
    {
      "number": 8,
      "recommendation": "Expand the repository notice, fan-project notice, and media attribution so all retained postures and the accepted exception are explicit.",
      "decision": "ACCEPTED_IMPLEMENTED"
    }
  ],
