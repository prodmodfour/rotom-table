{
  "schemaVersion": 1,
  "ticket": "P8-097",
  "status": "accepted",
  "manualStorageRepairRequired": false,
  "automaticReconnectReplayAllowed": false,
  "scenarios": [
    {
      "scenarioId": "duplicate-commands",
      "expected": "The exact accepted or rejected result replays without reroll, re-consumption, revision advance, or duplicate realtime publication.",
      "evidenceTests": [
        "tests/server/executeItemOperation.test.ts",
        "tests/server/itemOperationRepository.test.ts"
      ]
    },
    {
      "scenarioId": "stale-inventories",
      "expected": "Stale Trainer, group, target, and definition revisions reject before any cost or delivery and require fresh authority.",
      "evidenceTests": [
        "tests/integration/shopCheckoutConcurrency.test.ts",
        "tests/server/executeItemOperation.test.ts"
      ]
    },
    {
      "scenarioId": "moved-rows",
      "expected": "Moved, missing, duplicate-name, or fully reserved rows are never substituted; reconciliation is non-mutating.",
      "evidenceTests": [
        "tests/server/throwPokeballCommand.test.ts",
        "tests/utils/inventoryRecoveryStorage.test.ts"
      ]
    },
    {
      "scenarioId": "pending-choices",
      "expected": "Exact bounded choice authority and reservations survive pause/reload; stale choices cannot expand or commit.",
      "evidenceTests": [
        "tests/server/itemOperationRepository.test.ts",
        "tests/server/executeItemOperation.test.ts"
      ]
    },
    {
      "scenarioId": "reservations",
      "expected": "Pending quantity blocks competing transfer across restart and is released only by authenticated terminal recovery.",
      "evidenceTests": [
        "tests/integration/groupInventoryItemReservationRecovery.test.ts",
        "tests/server/itemOperationRepository.test.ts"
      ]
    },
    {
      "scenarioId": "server-restart",
      "expected": "Accepted, rejected, pending, capture, settlement, and correction state reload from durable evidence without rerunning mechanics.",
      "evidenceTests": [
        "tests/server/executeItemOperation.test.ts",
        "tests/server/commitEncounterSettlement.test.ts",
        "tests/server/encounterSettlementCorrection.test.ts"
      ]
    },
    {
      "scenarioId": "tab-echo-and-reconnect",
      "expected": "One retained strict command excludes competing tabs; online events never auto-submit it, and explicit status/retry remains exact.",
      "evidenceTests": [
        "tests/utils/inventoryRecoveryStorage.test.ts",
        "tests/utils/encounterSettlementOperationStorage.test.ts"
      ]
    },
    {
      "scenarioId": "partial-transaction-failure",
      "expected": "Failure at every item, map, sheet, inventory, settlement, history, attention, and realtime boundary rolls back without terminal evidence or partial revision.",
      "evidenceTests": [
        "tests/server/throwPokeballCommand.test.ts",
        "tests/server/encounterSettlementAtomicCommit.test.ts",
        "tests/server/commitEncounterSettlement.test.ts"
      ]
    },
    {
      "scenarioId": "settlement-retry",
      "expected": "Ambiguous commit retains one strict command; exact status returns accepted evidence, while no result requires explicit retry and current reauthorization.",
      "evidenceTests": [
        "tests/server/encounterSettlementRecovery.test.ts",
        "tests/utils/encounterSettlementOperationStorage.test.ts"
      ]
    },
    {
      "scenarioId": "correction",
      "expected": "One hash-bound GM correction appends immutable audit/realtime evidence, exact-replays after restart, and rolls back every failed boundary.",
      "evidenceTests": [
        "tests/server/encounterSettlementCorrection.test.ts"
      ]
    }
  ],
