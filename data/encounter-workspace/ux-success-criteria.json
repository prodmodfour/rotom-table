      "fixtures": ["private-reactions-reconnect", "boss-phases-environment"],
      "measurement": "Count forbidden labels, option values, hidden identities, private build facts, or diagnostic identifiers in public/unauthorized DOM, accessibility tree, snapshots, events, and screenshots.",
      "metric": "defect-count",
      "unit": "count",
      "aggregation": "all-audiences",
      "target": { "operator": "=", "value": 0 },
      "baseline": { "status": "automated-existing", "value": 0 },
      "releaseGate": true
    },
    {
      "id": "serious-accessibility-violations",
      "category": "accessibility",
