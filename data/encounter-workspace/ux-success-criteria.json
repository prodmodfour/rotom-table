      "taskIds": ["recover-uncertain-command", "handle-reconnect-stale-or-correction"],
      "fixtures": ["private-reactions-reconnect"],
      "measurement": "Count duplicate durable state changes after exact retry, tab echo, reconnect, stale adoption, and repeated accepted delivery.",
      "metric": "defect-count",
      "unit": "count",
      "aggregation": "all-acceptance-runs",
      "target": { "operator": "=", "value": 0 },
      "baseline": { "status": "automated-existing", "value": 0 },
      "releaseGate": true
    },
    {
      "id": "reconnect-convergence-time",
      "category": "multiplayer",
