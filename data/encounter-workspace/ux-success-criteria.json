      "taskIds": ["respond-to-optional-trigger", "recover-uncertain-command", "handle-reconnect-stale-or-correction"],
      "fixtures": ["private-reactions-reconnect"],
      "measurement": "Elapsed time from transport reconnected to workspace snapshot, pending stack, selected actor adoption, and accepted history convergence.",
      "metric": "duration",
      "unit": "milliseconds",
      "aggregation": "p90",
      "target": { "operator": "<=", "value": 5000 },
