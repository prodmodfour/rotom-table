{
  "schemaVersion": 1,
  "criteriaId": "encounter-ux-success-v1",
  "definedAt": "2026-08-04",
  "designAuthority": "DESIGN.md",
  "taskInventory": "data/encounter-workspace/encounter-task-inventory.json",
  "baselineEvidenceTicket": "EUX-009",
  "privacyPolicy": {
    "storeRawParticipantIds": false,
    "storeRulesChoiceValues": false,
    "storePrivatePrompts": false,
    "allowedDimensions": [
      "role-kind",
      "viewport-class",
      "input-kind",
      "motion-preference",
      "fixture-id",
      "spatiality-level",
      "terminal-status"
    ],
    "retention": "aggregate-only outside explicit test fixtures"
  },
  "canonicalFixtures": [
    "simple-trainer-duel",
    "crowded-wild-pack",
    "boss-phases-environment",
    "private-reactions-reconnect",
    "capability-movement-feature"
  ],
  "measurementEvents": [
    "workspace-ready",
    "actor-selected",
    "action-dock-opened",
    "action-filtered",
    "action-activated",
    "decision-presented",
    "decision-submitted",
    "resolution-waiting",
    "resolution-settled",
    "tactical-lens-opened",
    "tactical-lens-ready",
    "system-recovery-opened",
    "system-recovery-terminal",
    "accepted-presentation-started",
    "accepted-presentation-settled"
  ],
  "criteria": [
    {
      "id": "task-completion-critical",
      "category": "task-success",
      "title": "Critical encounter tasks complete without facilitator rescue",
      "taskIds": [
        "observe-current-turn",
        "discover-actions",
        "use-move",
        "choose-participant-targets",
        "move-participant",
        "respond-to-optional-trigger",
        "throw-pokeball",
        "recover-uncertain-command"
      ],
      "fixtures": [
        "simple-trainer-duel",
        "crowded-wild-pack",
        "private-reactions-reconnect",
        "capability-movement-feature"
      ],
      "measurement": "Moderated and scripted acceptance attempts completed with accepted authoritative terminal state and no out-of-band instruction.",
      "metric": "completion-rate",
      "unit": "percent",
      "aggregation": "overall-and-per-task",
      "target": { "operator": ">=", "value": 95 },
      "baseline": { "status": "pending", "ticket": "EUX-009" },
      "releaseGate": true
    },
    {
      "id": "action-discovery-time",
      "category": "action-discovery",
      "title": "A user finds an expected action quickly",
      "taskIds": ["discover-actions", "use-move", "use-ability", "use-maneuver-or-order", "throw-pokeball"],
      "fixtures": ["simple-trainer-duel", "crowded-wild-pack", "capability-movement-feature"],
      "measurement": "Elapsed time from actor-selected or action-dock-opened, whichever is later, to action-activated for a named expected action. Exclude network wait after activation.",
      "metric": "duration",
      "unit": "milliseconds",
      "aggregation": "median",
      "target": { "operator": "<=", "value": 5000 },
      "guardrail": { "aggregation": "p90", "operator": "<=", "value": 10000 },
      "baseline": { "status": "pending", "ticket": "EUX-009" },
      "releaseGate": true
    },
    {
      "id": "action-activation-input-count",
      "category": "interaction-cost",
      "title": "Primary actions avoid chapter-menu traversal",
      "taskIds": ["discover-actions", "use-move", "use-ability", "use-maneuver-or-order"],
      "fixtures": ["simple-trainer-duel", "capability-movement-feature"],
      "measurement": "Count pointer activations or keyboard commits after actor selection and before action activation; navigation keystrokes inside a single open list count as one sequence.",
      "metric": "input-count",
      "unit": "interactions",
      "aggregation": "p90",
      "target": { "operator": "<=", "value": 3 },
      "baseline": { "status": "pending", "ticket": "EUX-009" },
      "releaseGate": true
    },
    {
      "id": "keyboard-action-activation",
      "category": "interaction-cost",
      "title": "A keyboard user activates a known action efficiently",
      "taskIds": ["select-controlled-participant", "discover-actions", "use-move"],
      "fixtures": ["simple-trainer-duel"],
      "measurement": "Count Tab/arrow/navigation sequences and commits from workspace focus to action activation using only keyboard controls.",
      "metric": "input-count",
      "unit": "interactions",
      "aggregation": "p90",
      "target": { "operator": "<=", "value": 8 },
      "baseline": { "status": "pending", "ticket": "EUX-009" },
      "releaseGate": true
    },
    {
      "id": "response-completion-time",
      "category": "pending-response",
      "title": "Authorized responders understand and complete a pending choice",
      "taskIds": ["resolve-start-turn-conditions", "respond-to-optional-trigger", "pass-cancel-or-force-response"],
      "fixtures": ["simple-trainer-duel", "private-reactions-reconnect"],
      "measurement": "Elapsed time from decision-presented in the authorized projection to decision-submitted; exclude deliberate fixture wait instructions.",
      "metric": "duration",
      "unit": "milliseconds",
      "aggregation": "median",
      "target": { "operator": "<=", "value": 8000 },
      "guardrail": { "aggregation": "p90", "operator": "<=", "value": 15000 },
      "baseline": { "status": "pending", "ticket": "EUX-009" },
      "releaseGate": true
    },
    {
      "id": "response-unintended-abandonment",
      "category": "pending-response",
      "title": "Pending decisions are not abandoned because their owner or options are unclear",
      "taskIds": ["respond-to-optional-trigger", "pass-cancel-or-force-response", "recover-stuck-resolution"],
      "fixtures": ["private-reactions-reconnect", "boss-phases-environment"],
      "measurement": "Share of test decisions that expire, are force-passed, or require GM rescue when the scripted responder intended to answer normally.",
      "metric": "error-rate",
      "unit": "percent",
      "aggregation": "overall",
      "target": { "operator": "<=", "value": 2 },
      "baseline": { "status": "pending", "ticket": "EUX-009" },
      "releaseGate": true
    },
    {
      "id": "non-spatial-forced-lens-rate",
      "category": "progressive-spatiality",
      "title": "Non-spatial tasks never force the tactical lens",
      "taskIds": ["discover-actions", "understand-unavailable-action", "respond-to-optional-trigger", "inspect-participant", "view-accepted-outcome"],
      "fixtures": ["simple-trainer-duel", "crowded-wild-pack", "private-reactions-reconnect"],
      "measurement": "Share of tasks marked spatiality none that open the tactical lens without an explicit user inspect request.",
      "metric": "forced-lens-rate",
      "unit": "percent",
      "aggregation": "overall",
      "target": { "operator": "=", "value": 0 },
      "baseline": { "status": "pending", "ticket": "EUX-009" },
      "releaseGate": true
    },
    {
      "id": "exact-spatial-lens-coverage",
      "category": "progressive-spatiality",
      "title": "Exact geometry remains available whenever required",
      "taskIds": ["choose-area-direction-or-placement", "move-participant", "author-hazards"],
      "fixtures": ["crowded-wild-pack", "boss-phases-environment", "capability-movement-feature"],
      "measurement": "Share of scripted exact-cell/path/area decisions that can open the tactical lens, complete valid geometry, cancel, and restore focus.",
      "metric": "completion-rate",
      "unit": "percent",
      "aggregation": "overall",
      "target": { "operator": "=", "value": 100 },
      "baseline": { "status": "pending", "ticket": "EUX-009" },
      "releaseGate": true
    },
    {
      "id": "tactical-lens-invocation-observation",
      "category": "progressive-spatiality",
      "title": "Tactical lens use is measured by spatiality rather than minimized blindly",
      "taskIds": ["choose-participant-targets", "choose-area-direction-or-placement", "move-participant", "request-gm-attention"],
      "fixtures": ["simple-trainer-duel", "crowded-wild-pack", "capability-movement-feature"],
      "measurement": "Record explicit and automatic tactical-lens-opened events grouped only by fixture and spatiality level. Review outliers; no global lower-is-better score is allowed.",
      "metric": "invocation-rate",
      "unit": "percent",
      "aggregation": "by-spatiality-level",
      "target": { "operator": "review", "value": 100 },
      "baseline": { "status": "pending", "ticket": "EUX-009" },
      "releaseGate": false
    },
    {
      "id": "safe-recovery-time",
      "category": "error-recovery",
      "title": "An uncertain command reaches a safe terminal state quickly",
      "taskIds": ["recover-uncertain-command", "handle-reconnect-stale-or-correction"],
      "fixtures": ["private-reactions-reconnect"],
      "measurement": "Elapsed time from system-recovery-opened to accepted, rejected, adopted, or explicitly abandoned terminal status in scripted reconnect and timeout cases.",
      "metric": "duration",
