  "document": {
    "schemaVersion": 1,
    "identity": "skill-check:v1:<stable-id>",
    "revisionPolicy": "monotonic-plus-one",
    "states": ["pending", "ready", "accepted", "cancelled", "timed-out"],
    "terminalStates": ["accepted", "cancelled", "timed-out"],
    "subjectKinds": ["trainer", "pokemon"],
    "subjectCountMinimum": 1,
    "subjectCountMaximum": 32,
    "modes": ["single", "group"],
