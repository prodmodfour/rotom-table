      "dc": {
        "difficultyClassMinimum": 1,
        "difficultyClassMaximum": 100,
        "success": "final-total-greater-than-or-equal-to-dc",
        "resultScope": "per-subject"
      },
      "opposed": {
        "subjectCount": 2,
        "winner": "higher-final-total",
        "tiePolicy": "reroll-both-up-to-10-then-journaled-server-coin"
      }
    },
    "modifierResolution": {
      "sheetDice": "resolve-current-authoritative-sheet-at-commit",
      "sheetRevision": "exact-read-set",
      "automationModifiers": "server-provider-registry-only",
      "situationalModifierMinimum": -20,
      "situationalModifierMaximum": 20,
      "clientRolls": "forbidden",
      "clientResolvedModifiers": "forbidden"
    },
    "journal": {
      "dieSides": 6,
      "serverRandomnessOnly": true,
      "appendOnly": true,
      "records": ["journalId", "subjectId", "attempt", "diceCount", "flatModifier", "contributors", "results", "dieTotal", "finalTotal", "rolledAt"],
      "opposedTieBreakEncoding": "after the initial roll and ten tied rerolls, one extra d6 journal with reserved contributor system:opposed-tie-break-coin acts as a fair coin by parity: odd selects the first subject and even selects the second"
    },
    "acceptedResults": {
      "immutableWithoutCorrection": true,
      "correctionRequiresGmReceipt": true,
      "historyRequired": true,
      "campaignAttentionWhenUnresolved": true
    }
  },
  "operations": {
    "kinds": ["request", "respond", "resolve", "cancel", "timeout", "correct"],
    "operationIdentity": "skill-check-op:v1:<stable-id>",
    "idempotency": "operation-id-plus-canonical-command-hash",
    "exactRetry": "return-original-terminal-or-pending-result-without-reroll",
    "expectedRevisionRequired": true,
    "request": {
      "authorizedRole": "gm",
      "serverResolvedFields": ["sheet-revisions", "controllers", "skill-dice", "automation-modifiers"],
      "clientMayDeclare": ["subjects", "skill-ids", "comparison-policy", "dc", "situational-modifier", "prompt", "visibility", "expiry"]
    },
    "respond": {
      "authorizedRoles": ["gm", "subject-owner"],
      "decisions": ["accept", "decline"],
      "payload": "opaque-subject-id-and-decision-only"
    },
    "resolve": {
      "authorizedRole": "gm-or-auto-after-all-required-acceptances",
      "payload": "no-rolls-no-modifiers",
      "effect": "server-resolve-read-set-roll-journal-and-accept-atomically"
    },
    "cancel": {"authorizedRole": "gm", "allowedStates": ["pending", "ready"]},
    "timeout": {"authorizedRole": "server-clock", "allowedStates": ["pending", "ready"]},
    "correct": {"authorizedRole": "gm", "allowedStates": ["accepted"], "diceEvidenceMutable": false}
  },
  "privacy": {
    "gm": ["requester", "all-subjects", "dc", "opposed-policy", "all-modifiers", "notes", "all-journals", "all-results", "corrections"],
    "subject": ["own-request", "own-skill", "own-modifier-explanation", "own-response", "authorized-accepted-results"],
    "spectatorPending": ["check-identity", "public-label", "pending-count"],
    "spectatorAccepted": ["public-label", "authorized-result-summary"],
    "neverPublic": ["gm-notes", "private-dc", "other-subject-private-modifier-breakdown", "operation-hashes", "read-sets", "diagnostics"],
