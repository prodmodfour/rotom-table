{
  "name": "rotom-table",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:session:lan": "node scripts/session-host-dev.mjs --mode lan",
    "dev:session:tunnel": "node scripts/session-host-dev.mjs --mode tunnel",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "migrate:sqlite": "node scripts/migrate-campaign-to-sqlite.mjs",
    "export:sqlite-json": "node scripts/export-sqlite-json.mjs",
    "realtime:status": "node scripts/realtime-retention.mjs status",
    "realtime:prune": "node scripts/realtime-retention.mjs prune",
    "postinstall": "NODE_ENV=development nuxt prepare",
    "typecheck": "NODE_ENV=development nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:encounter-presentation": "node scripts/check-encounter-presentation-contract.mjs",
    "generate:encounter-presentation-inventory": "node scripts/generate-encounter-presentation-inventory.mjs",
    "test:nuxt": "vitest run --config vitest.nuxt.config.ts",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "refactor:loop": "bash scripts/refactor-loop.sh",
    "check:ability-automation": "vite-node --config vitest.config.ts scripts/check_ability_automation.ts",
    "check:capability-automation": "vite-node --config vitest.config.ts scripts/check_capability_automation.ts",
    "check:capability-automation-complete": "vite-node --config vitest.config.ts scripts/check_capability_automation.ts --check-plan",
    "seed:capability-automation": "python3 scripts/seed_capability_automation_manifest.py",
    "check:edge-automation": "vite-node --config vitest.config.ts scripts/check_edge_automation.ts",
    "check:edge-automation-complete": "vite-node --config vitest.config.ts scripts/check_edge_automation.ts --check-plan",
    "seed:edge-automation": "python3 scripts/seed_edge_automation_manifest.py",
    "check:ability-automation-complete": "vite-node --config vitest.config.ts scripts/check_ability_automation.ts --require-complete --check-plan",
    "check:ability-automation-links": "vite-node --config vitest.config.ts scripts/check_ability_automation.ts",
    "check:ability-automation-budgets": "vitest run tests/server/abilityAutomationMetadataBudgets.test.ts",
    "check:ability-automation-plan": "vite-node --config vitest.config.ts scripts/check_ability_automation.ts --check-plan",
    "audit:ability-automation": "vite-node --config vitest.config.ts scripts/check_ability_automation.ts --check-plan --report",
    "check:move-automation": "python3 scripts/check_move_automation_coverage.py",
    "check:move-automation-complete": "python3 scripts/check_move_automation_coverage.py --require-complete && vitest run tests/server/moveAutomationCanonicalCompletionAudit.test.ts",
    "check:move-automation-budgets": "vitest run tests/server/moveAutomationPerformanceBudgets.test.ts",
    "audit:move-automation-completion": "vitest run tests/server/moveAutomationCanonicalCompletionAudit.test.ts && python3 scripts/check_move_automation_coverage.py --require-complete --report",
    "generate:move-automation-menu-status": "python3 scripts/generate_move_automation_menu_status.py",
    "check:move-automation-menu-status": "python3 scripts/generate_move_automation_menu_status.py --check",
    "audit:move-automation-legacy": "vite-node --config vitest.config.ts scripts/generate_move_automation_legacy_audit.ts",
    "link:move-automation-legacy": "vite-node --config vitest.config.ts scripts/link_move_automation_legacy_manifest.ts",
    "check:move-automation-legacy-links": "vite-node --config vitest.config.ts scripts/link_move_automation_legacy_manifest.ts --check",
    "sync:item-sprites": "node scripts/sync_item_sprites.mjs",
    "generate:profile-sprites": "python3 scripts/generate_profile_sprites.py"
  },
  "overrides": {
    "archiver": {
      "readdir-glob": "3.0.0"
    },
    "minimatch": "10.2.6"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@phosphor-icons/vue": "^2.2.1",
    "nuxt": "^4.5.1",
    "three": "^0.176.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.0",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.3.8"
  }
}
